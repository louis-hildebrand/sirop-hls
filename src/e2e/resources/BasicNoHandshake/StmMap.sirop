const n: u32 = 10
const m: u32 = (n -% 1:u32) / 2:u32
const coeffs: Vec[u16, m] = vbuild(m) { (_: u32) => 5:u16 }

accelerator[no_handshake] add5 = (original: Stm[Vec[u16, m], n]) =>
    original
    .StmMap( (v) =>
        v.VecZip(coeffs)
            .VecMap((x) => x.0 + x.1),
        /* head= */ VecCst(m, 0:u16)
    )

assert {
    original = [
        undefined:Vec[u16, 4]
    ]s ++ [
        [ 0:u16,  1:u16,  2:u16,  3:u16]v,
        [ 4:u16,  5:u16,  6:u16,  7:u16]v,
        [ 8:u16,  9:u16, 10:u16, 11:u16]v,
        [12:u16, 13:u16, 14:u16, 15:u16]v,
        [16:u16, 17:u16, 18:u16, 19:u16]v,
        [20:u16, 21:u16, 22:u16, 23:u16]v,
        [24:u16, 25:u16, 26:u16, 27:u16]v,
        [28:u16, 29:u16, 30:u16, 31:u16]v,
        [32:u16, 33:u16, 34:u16, 35:u16]v,
        [36:u16, 37:u16, 38:u16, 39:u16]v
    ]s
}
yields [
    [ 5:u16,  6:u16,  7:u16,  8:u16]v,
    [ 9:u16, 10:u16, 11:u16, 12:u16]v,
    [13:u16, 14:u16, 15:u16, 16:u16]v,
    [17:u16, 18:u16, 19:u16, 20:u16]v,
    [21:u16, 22:u16, 23:u16, 24:u16]v,
    [25:u16, 26:u16, 27:u16, 28:u16]v,
    [29:u16, 30:u16, 31:u16, 32:u16]v,
    [33:u16, 34:u16, 35:u16, 36:u16]v,
    [37:u16, 38:u16, 39:u16, 40:u16]v,
    [41:u16, 42:u16, 43:u16, 44:u16]v
]s
