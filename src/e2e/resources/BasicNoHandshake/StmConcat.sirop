accelerator[no_handshake, go=go, head(b)=undefined, head(go)=false]
top = (a: Stm[i8, 3]) => (b: Stm[i8, 4]) => (go: Stm[bool, 7]) =>
    StmConcat(a, b, -1:i8)

assert {
    a = [undefined:i8]s ++ [99:i8, 98:i8, 97:i8]s,
    b = [undefined:i8]s ++ [42:i8, -43:i8, 44:i8, -45:i8]s,
    go = [false]s ++ [true, true, true, true, true, true, true]s
}
yields [99:i8, 98:i8, 97:i8, 42:i8, -43:i8, 44:i8, -45:i8]s
