const N: u32 = 3
const M: u32 = 4

accelerator[no_handshake, go=go, head(a)=undefined, head(b)=undefined]
top = (a: Stm[i8, N]) => (b: Stm[i8, M] @ N) => (go: Stm[bool, N+M] @ N-1) =>
    StmConcat(a, b, -1:i8)

assert {
    a = [99:i8, 98:i8, 97:i8]s,
    b = [42:i8, -43:i8, 44:i8, -45:i8]s,
    go = [true, true, true, true, true, true, true]s
}
yields [99:i8, 98:i8, 97:i8, 42:i8, -43:i8, 44:i8, -45:i8]s
