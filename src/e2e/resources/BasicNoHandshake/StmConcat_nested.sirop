    ]s,
    go = [true, true, true, true, true, true, true, true, true, true, true, true]s
}
yields [
    [99:i8, 98:i8, 97:i8]s,
    [89:i8, 88:i8, 87:i8]s,
    [79:i8, 78:i8, 77:i8]s,
