const N: u32 = 5

accelerator[no_handshake]
top = (s: Stm[i16, N]) =>
    StmRange(N, 0:u8, 1:u8)
    .StmZip(s)

assert {
    s = [undefined[i16]]s ++ [-1:i16, 2:i16, -3:i16, 4:i16, -5:i16]s
}
yields [(0:u8, -1:i16), (1:u8, 2:i16), (2:u8, -3:i16), (3:u8, 4:i16), (4:u8, -5:i16)]s

assert {
    s = [undefined[i16], undefined[i16]]s ++ [1:i16, 4:i16, 9:i16, 16:i16, 25:i16]s
}
yields [(0:u8, 1:i16), (1:u8, 4:i16), (2:u8, 9:i16), (3:u8, 16:i16), (4:u8, 25:i16)]s
