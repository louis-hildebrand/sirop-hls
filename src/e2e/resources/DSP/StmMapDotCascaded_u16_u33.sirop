accelerator[no_handshake, out_name=z_o, head(x_i)=undefined, head(y_i)=undefined]
foo = (x_i: Stm[Vec[u16, M], N]) => (y_i: Stm[Vec[u16, M], N]) =>
    StmMapDotCascaded:[u33](x_i.StmCascade(), y_i.StmCascade(), /*delay*/ PIPELINE)

assert {
    x_i = [
        [30234:u16, 27592:u16, 43946:u16, 8857:u16, 39275:u16]v,
        [64223:u16, 7456:u16, 53607:u16, 5789:u16, 18072:u16]v,
        [48537:u16, 14576:u16, 48274:u16, 64763:u16, 21900:u16]v,
        [3382:u16, 59833:u16, 25216:u16, 34968:u16, 50466:u16]v
    ]s,
    y_i = [
        [63756:u16, 17057:u16, 39185:u16, 62455:u16, 9841:u16]v,
        [44863:u16, 28997:u16, 39465:u16, 9906:u16, 21850:u16]v,
        [59160:u16, 13658:u16, 40977:u16, 34241:u16, 19865:u16]v,
        [4397:u16, 3894:u16, 12737:u16, 7812:u16, 63218:u16]v
    ]s
}
yields [
