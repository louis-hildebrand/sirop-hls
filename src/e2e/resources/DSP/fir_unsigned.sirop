const N: u32 = 16
// TODO: Use DEPTH = 5 or DEPTH = 7 instead for a more challenging test
const DEPTH: u32 = 6
// Number of pipeline registers to insert at the inputs to the DSPs.
const PIPELINE: u32 = 2

accelerator top =
(s1: Stm[u18, N]) =>
(s2: Stm[u18, N]) =>
    MulAddCascaded(
        s1.StmMap( x => VecCst(DEPTH, x) ),
        s2.StmMap( x => VecCst(DEPTH, x) ),
        PIPELINE
    )
    .StmMap( x => truncate18(x) )

const YES : u18 = ones:[u18]()
const no  : u18 = zeros:[u18]()

assert {
    s1 = StmRange(N, 2:u18, 1:u18),
    s2 = StmRange(N, 2:u18, 1:u18)
}
yields [
     0:u18,
     0:u18,
     2:u18*2,
     2:u18*2  +  3:u18*3,
     2:u18*2  +  3:u18*3  +  4:u18*4,
     2:u18*2  +  3:u18*3  +  4:u18*4  +  5:u18*5,
     2:u18*2  +  3:u18*3  +  4:u18*4  +  5:u18*5  +  6:u18*6,
     2:u18*2  +  3:u18*3  +  4:u18*4  +  5:u18*5  +  6:u18*6  +  7:u18*7,
     3:u18*3  +  4:u18*4  +  5:u18*5  +  6:u18*6  +  7:u18*7  +  8:u18*8,
     4:u18*4  +  5:u18*5  +  6:u18*6  +  7:u18*7  +  8:u18*8  +  9:u18*9,
     5:u18*5  +  6:u18*6  +  7:u18*7  +  8:u18*8  +  9:u18*9  + 10:u18*10,
     6:u18*6  +  7:u18*7  +  8:u18*8  +  9:u18*9  + 10:u18*10 + 11:u18*11,
     7:u18*7  +  8:u18*8  +  9:u18*9  + 10:u18*10 + 11:u18*11 + 12:u18*12,
     8:u18*8  +  9:u18*9  + 10:u18*10 + 11:u18*11 + 12:u18*12 + 13:u18*13,
     9:u18*9  + 10:u18*10 + 11:u18*11 + 12:u18*12 + 13:u18*13 + 14:u18*14,
    10:u18*10 + 11:u18*11 + 12:u18*12 + 13:u18*13 + 14:u18*14 + 15:u18*15
]s
ignoring [
    YES,
    YES,
    YES,
    YES,
    YES,
    YES,
    YES,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no
]s

assert {
    s1 = StmRange(N, 42:i19, -1:i19).StmMap( x => unsign(x) ),
    s2 = StmRange(N, 1:u18, 2:u18)
}
yields [
    0:u18,
    0:u18,
    42:u18*1,
    42:u18*1  + 41:u18*3,
    42:u18*1  + 41:u18*3  + 40:u18*5,
    42:u18*1  + 41:u18*3  + 40:u18*5  + 39:u18*7,
    42:u18*1  + 41:u18*3  + 40:u18*5  + 39:u18*7  + 38:u18*9,
    42:u18*1  + 41:u18*3  + 40:u18*5  + 39:u18*7  + 38:u18*9  + 37:u18*11,
    41:u18*3  + 40:u18*5  + 39:u18*7  + 38:u18*9  + 37:u18*11 + 36:u18*13,
    40:u18*5  + 39:u18*7  + 38:u18*9  + 37:u18*11 + 36:u18*13 + 35:u18*15,
    39:u18*7  + 38:u18*9  + 37:u18*11 + 36:u18*13 + 35:u18*15 + 34:u18*17,
    38:u18*9  + 37:u18*11 + 36:u18*13 + 35:u18*15 + 34:u18*17 + 33:u18*19,
    37:u18*11 + 36:u18*13 + 35:u18*15 + 34:u18*17 + 33:u18*19 + 32:u18*21,
    36:u18*13 + 35:u18*15 + 34:u18*17 + 33:u18*19 + 32:u18*21 + 31:u18*23,
    35:u18*15 + 34:u18*17 + 33:u18*19 + 32:u18*21 + 31:u18*23 + 30:u18*25,
    34:u18*17 + 33:u18*19 + 32:u18*21 + 31:u18*23 + 30:u18*25 + 29:u18*27
]s
ignoring [
    YES,
    YES,
    YES,
    YES,
    YES,
    YES,
    YES,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no
]s
