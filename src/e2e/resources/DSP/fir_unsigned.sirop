const N: u32 = 16
const DEPTH: u32 = 5
// Number of pipeline registers to insert at the inputs to the DSPs.
const PIPELINE: u32 = 2

accelerator top =
(s1: Stm[u18, N]) =>
(s2: Stm[u18, N]) =>
    MulAddCascaded(
        // See what happens when the input to the DSP is not a simple name
        s1.StmMap( x => x << 1 ).StmMap( x => VecCst(DEPTH, x) ),
        s2.StmMap( x => VecCst(DEPTH, x) ),
        PIPELINE
    )
    .StmMap( x => truncate18(x) )

const YES : u18 = ones:[u18]()
const no  : u18 = zeros:[u18]()

assert {
    s1 = StmRange(N, 2:u18, 1:u18),
    s2 = StmRange(N, 2:u18, 1:u18)
}
yields [
    2 * ( 0:u18),
    2 * ( 0:u18),
    2 * ( 2:u18*2),
    2 * ( 2:u18*2  +  3:u18*3),
    2 * ( 2:u18*2  +  3:u18*3  +  4:u18*4),
    2 * ( 2:u18*2  +  3:u18*3  +  4:u18*4  +  5:u18*5),
    2 * ( 2:u18*2  +  3:u18*3  +  4:u18*4  +  5:u18*5  +  6:u18*6),
    2 * ( 3:u18*3  +  4:u18*4  +  5:u18*5  +  6:u18*6  +  7:u18*7),
    2 * ( 4:u18*4  +  5:u18*5  +  6:u18*6  +  7:u18*7  +  8:u18*8),
    2 * ( 5:u18*5  +  6:u18*6  +  7:u18*7  +  8:u18*8  +  9:u18*9),
    2 * ( 6:u18*6  +  7:u18*7  +  8:u18*8  +  9:u18*9  + 10:u18*10),
    2 * ( 7:u18*7  +  8:u18*8  +  9:u18*9  + 10:u18*10 + 11:u18*11),
    2 * ( 8:u18*8  +  9:u18*9  + 10:u18*10 + 11:u18*11 + 12:u18*12),
    2 * ( 9:u18*9  + 10:u18*10 + 11:u18*11 + 12:u18*12 + 13:u18*13),
    2 * (10:u18*10 + 11:u18*11 + 12:u18*12 + 13:u18*13 + 14:u18*14),
    2 * (11:u18*11 + 12:u18*12 + 13:u18*13 + 14:u18*14 + 15:u18*15)
]s
ignoring [
    YES,
    YES,
    YES,
    YES,
    YES,
    YES,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no
]s

assert {
    s1 = StmRange(N, 42:i19, -1:i19).StmMap( x => unsign(x) ),
    s2 = StmRange(N, 1:u18, 2:u18)
}
yields [
    2 * (0:u18),
    2 * (0:u18),
    2 * (42:u18*1),
    2 * (42:u18*1  + 41:u18*3),
    2 * (42:u18*1  + 41:u18*3  + 40:u18*5),
    2 * (42:u18*1  + 41:u18*3  + 40:u18*5  + 39:u18*7),
    2 * (42:u18*1  + 41:u18*3  + 40:u18*5  + 39:u18*7  + 38:u18*9),
    2 * (41:u18*3  + 40:u18*5  + 39:u18*7  + 38:u18*9  + 37:u18*11),
    2 * (40:u18*5  + 39:u18*7  + 38:u18*9  + 37:u18*11 + 36:u18*13),
    2 * (39:u18*7  + 38:u18*9  + 37:u18*11 + 36:u18*13 + 35:u18*15),
    2 * (38:u18*9  + 37:u18*11 + 36:u18*13 + 35:u18*15 + 34:u18*17),
    2 * (37:u18*11 + 36:u18*13 + 35:u18*15 + 34:u18*17 + 33:u18*19),
    2 * (36:u18*13 + 35:u18*15 + 34:u18*17 + 33:u18*19 + 32:u18*21),
    2 * (35:u18*15 + 34:u18*17 + 33:u18*19 + 32:u18*21 + 31:u18*23),
    2 * (34:u18*17 + 33:u18*19 + 32:u18*21 + 31:u18*23 + 30:u18*25),
    2 * (33:u18*19 + 32:u18*21 + 31:u18*23 + 30:u18*25 + 29:u18*27)
]s
ignoring [
    YES,
    YES,
    YES,
    YES,
    YES,
    YES,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no,
    no
]s
